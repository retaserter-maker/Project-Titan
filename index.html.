
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>EARTH EXPLORER 3D</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background: #020711;
  color: white;
  font-family: Arial, sans-serif;
  overflow: hidden;
}

#globe {
  position: fixed;
  inset: 0;
  z-index: 0;
}

header {
  position: absolute;
  z-index: 5;
  top: 0;
  left: 0;
  width: 100%;
  padding: 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  pointer-events: none;
}

.logo {
  font-size: 17px;
  font-weight: bold;
  letter-spacing: 2px;
  text-shadow: 0 0 15px #00aaff;
}

.status {
  font-size: 10px;
  color: #4deaff;
  border: 1px solid #147caa;
  border-radius: 20px;
  padding: 7px 10px;
  background: #06182b;
}

.panel {
  position: absolute;
  z-index: 5;
  top: 75px;
  left: 12px;
  right: 12px;
  max-width: 430px;
  margin: auto;
  background: rgba(4, 17, 34, .88);
  border: 1px solid rgba(0, 174, 255, .35);
  border-radius: 15px;
  padding: 12px;
  backdrop-filter: blur(14px);
}

.search {
  display: flex;
  gap: 7px;
}

input {
  width: 100%;
  min-width: 0;
  background: #0a1d32;
  border: 1px solid #17496a;
  color: white;
  border-radius: 9px;
  padding: 12px;
  outline: none;
  font-size: 14px;
}

button {
  border: 1px solid #087db5;
  color: white;
  background: linear-gradient(135deg,#075b91,#082b53);
  padding: 10px 13px;
  border-radius: 9px;
  cursor: pointer;
  font-weight: bold;
}

button:active {
  transform: scale(.97);
}

.actions {
  display: flex;
  gap: 7px;
  margin-top: 9px;
}

.actions button {
  flex: 1;
  font-size: 11px;
  padding: 10px 5px;
}

#message {
  font-size: 11px;
  color: #9bc9e8;
  margin-top: 9px;
  min-height: 14px;
  line-height: 1.4;
}

.bottom {
  position: absolute;
  z-index: 5;
  left: 12px;
  right: 12px;
  bottom: 12px;
  max-height: 37%;
  overflow-y: auto;
  background: rgba(4, 16, 32, .94);
  border: 1px solid #12618a;
  border-radius: 16px;
  padding: 13px;
  backdrop-filter: blur(15px);
}

.bottom h3 {
  font-size: 14px;
  margin-bottom: 10px;
  color: #5bdfff;
}

#places {
  display: grid;
  gap: 7px;
}

.place {
  background: #0b2038;
  border: 1px solid #174768;
  border-radius: 9px;
  padding: 10px;
  cursor: pointer;
}

.place strong {
  font-size: 13px;
  display: block;
}

.place small {
  color: #9cb9d2;
  font-size: 10px;
}

.place:active {
  background: #123c60;
}

#selected {
  font-size: 12px;
  color: #c3e6ff;
  margin-top: 10px;
  line-height: 1.5;
}

#selected a {
  color: #56d9ff;
}

@media(min-width:700px) {
  .panel {
    left: 20px;
    right: auto;
    width: 380px;
  }

  .bottom {
    right: 20px;
    left: auto;
    bottom: 20px;
    width: 350px;
    max-height: 55%;
  }
}
</style>
</head>

<body>

<div id="globe"></div>

<header>
  <div class="logo">🌍 EARTH EXPLORER</div>
  <div class="status">● 3D ONLINE</div>
</header>

<section class="panel">
  <div class="search">
    <input id="city" placeholder="Найти город или страну...">
    <button onclick="searchCity()">Найти</button>
  </div>

  <div class="actions">
    <button onclick="locateMe()">📍 Где я?</button>
    <button onclick="loadPlaces()">🏙️ Места</button>
    <button onclick="resetGlobe()">🌍 Земля</button>
  </div>

  <div id="message">Загружаем нашу планету...</div>
</section>

<section class="bottom">
  <h3>📍 ПОПУЛЯРНЫЕ МЕСТА</h3>
  <div id="places">
    <div class="place">
      <strong>Исследуй планету</strong>
      <small>Найди город или определи своё местоположение</small>
    </div>
  </div>
  <div id="selected">Выбери место, чтобы увидеть подробности.</div>
</section>

<script src="https://unpkg.com/three@0.160.0/build/three.min.js"></script>
<script src="https://unpkg.com/globe.gl"></script>

<script>
const $ = id => document.getElementById(id);

let globe;
let currentCity = null;
let currentPlaces = [];
let searchBusy = false;

function message(text) {
  $("message").textContent = text;
}

function startGlobe() {
  try {
    globe = Globe()($("globe"))
      .globeImageUrl(
        "https://unpkg.com/three-globe/example/img/earth-blue-marble.jpg"
      )
      .bumpImageUrl(
        "https://unpkg.com/three-globe/example/img/earth-topology.png"
      )
      .backgroundImageUrl(
        "https://unpkg.com/three-globe/example/img/night-sky.png"
      )
      .showAtmosphere(true)
      .atmosphereColor("#3aabff")
      .atmosphereAltitude(0.18)
      .pointsData([])
      .pointLat("lat")
      .pointLng("lng")
      .pointAltitude("alt")
      .pointRadius("radius")
      .pointColor("color")
      .pointLabel("name")
      .onPointClick(point => {
        showPlace(point);
        focusLocation(point.lat, point.lng);
      });

    globe.pointOfView({
      lat: 25,
      lng: 10,
      altitude: 2.5
    });

    globe.controls().autoRotate = true;
    globe.controls().autoRotateSpeed = 0.35;
    globe.controls().enableDamping = true;

    window.addEventListener("resize", () => {
      if (globe) {
        globe.width(window.innerWidth);
        globe.height(window.innerHeight);
      }
    });

    message("Планета готова. Найди свой город!");
  } catch (e) {
    message("Ошибка загрузки 3D. Проверь интернет и обнови страницу.");
  }
}

function focusLocation(lat, lng) {
  if (!globe) return;

  globe.pointOfView({
    lat: lat,
    lng: lng,
    altitude: 0.65
  }, 1800);
}

function resetGlobe() {
  if (!globe) return;

  globe.pointOfView({
    lat: 25,
    lng: 10,
    altitude: 2.5
  }, 1500);

  globe.controls().autoRotate = true;
  message("Возвращаемся к виду всей планеты.");
}

function setMarkers(points) {
  if (!globe) return;

  globe.pointsData(points);
}

function showPlace(place) {
  $("selected").innerHTML =
    "<strong>" + escapeHTML(place.name) + "</strong><br>" +
    escapeHTML(place.description || "Интересное место") +
    "<br><br><a target='_blank' rel='noopener' href='https://www.openstreetmap.org/?mlat=" +
    encodeURIComponent(place.lat) + "&mlon=" +
    encodeURIComponent(place.lng) +
    "#map=16/" + encodeURIComponent(place.lat) +
    "/" + encodeURIComponent(place.lng) +
    "'>Открыть на карте ↗</a>";
}

function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g, char => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;"
  })[char]);
}

async function searchCity() {
  const query = $("city").value.trim();

  if (!query || searchBusy) {
    message("Введи название города.");
    return;
  }

  searchBusy = true;
  message("Ищем город...");

  try {
    const url =
      "https://nominatim.openstreetmap.org/search?format=jsonv2&limit=5&q=" +
      encodeURIComponent(query);

    const response = await fetch(url);

    if (!response.ok) throw new Error("Search unavailable");

    const data = await response.json();

    if (!data.length) {
      message("Город не найден. Попробуй другое название.");
      return;
    }

    const city = data[0];

    currentCity = {
      lat: Number(city.lat),
      lng: Number(city.lon),
      name: city.display_name
    };

    globe.controls().autoRotate = false;
    focusLocation(currentCity.lat, currentCity.lng);

    setMarkers([{
      ...currentCity,
      name: "📍 " + city.display_name,
      description: "Найденное местоположение",
      color: "#00eaff",
      radius: 0.65,
      alt: 0.025
    }]);

    $("selected").textContent =
      "Выбран город: " + city.display_name;

    await loadPlaces();
  } catch (e) {
    message("Не удалось найти город. Проверь интернет и повтори.");
  } finally {
    searchBusy = false;
  }
}

async function locateMe() {
  if (!navigator.geolocation) {
    message("Браузер не поддерживает геолокацию.");
    return;
  }

  message("Запрашиваем разрешение на местоположение...");

  navigator.geolocation.getCurrentPosition(
    async position => {
      const lat = position.coords.latitude;
      const lng = position.coords.longitude;

      currentCity = {
        lat,
        lng,
        name: "Моё местоположение"
      };

      globe.controls().autoRotate = false;
      focusLocation(lat, lng);

      setMarkers([{
        ...currentCity,
        name: "📍 Я здесь",
        description: "Ваше текущее местоположение",
        color: "#00ffae",
        radius: 0.75,
        alt: 0.025
      }]);

      message("Местоположение найдено!");

      try {
        const url =
          "https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=" +
          lat + "&lon=" + lng;

        const response = await fetch(url);

        if (response.ok) {
          const data = await response.json();
          const address = data.address || {};

          currentCity.name =
            address.city ||
            address.town ||
            address.village ||
            address.state ||
            "Ваше местоположение";

          $("selected").textContent =
            "Вы находитесь рядом с: " + currentCity.name;
        }
      } catch (e) {
        $("selected").textContent =
          "Координаты найдены. Название места получить не удалось.";
      }

      await loadPlaces();
    },
    error => {
      if (error.code === 1) {
        message("Разреши доступ к местоположению в браузере.");
      } else if (error.code === 2) {
        message("Не удалось определить местоположение.");
      } else {
        message("Время ожидания геолокации истекло.");
      }
    },
    {
      enableHighAccuracy: true,
      timeout: 15000,
      maximumAge: 60000
    }
  );
}

async function loadPlaces() {
  if (!currentCity) {
    if (!currentCity) message("Сначала найди город или нажми «Где я?»");
    return;
  }

  searchBusy = true;
  message("Ищем достопримечательности рядом...");

  try {
    const lat = currentCity.lat;
    const lng = currentCity.lng;

    const query = `
[out:json][timeout:25];
(
  node["name"]["tourism"~"attraction|museum|viewpoint|zoo"](around:7000,${lat},${lng});
  way["name"]["tourism"~"attraction|museum|viewpoint|zoo"](around:7000,${lat},${lng});
  relation["name"]["tourism"~"attraction|museum|viewpoint|zoo"](around:7000,${lat},${lng});

  node["name"]["historic"](around:7000,${lat},${lng});
  way["name"]["historic"](around:7000,${lat},${lng});

  node["name"]["leisure"~"park|garden"](around:7000,${lat},${lng});
  way["name"]["leisure"~"park|garden"](around:7000,${lat},${lng});
);
out center tags;
`;

    const response = await fetch(
      "https://overpass-api.de/api/interpreter",
      {
        method: "POST",
        body: query
      }
    );

    if (!response.ok) throw new Error("Places unavailable");

    const data = await response.json();

    const places = data.elements
      .map(item => {
        const tags = item.tags || {};

        return {
          name: tags.name,
          lat: item.lat ?? item.center?.lat,
          lng: item.lon ?? item.center?.lon,
          description:
            tags.tourism ||
            tags.historic ||
            tags.leisure ||
            "Интересное место",
          color: "#ffbd54",
          radius: 0.42,
          alt: 0.018
        };
      })
      .filter(item =>
        item.name &&
        Number.isFinite(item.lat) &&
        Number.isFinite(item.lng)
      );

    const unique = [];
    const seen = new Set();

    for (const place of places) {
      const key = place.name + place.lat.toFixed(4) + place.lng.toFixed(4);

      if (!seen.has(key)) {
        seen.add(key);
        unique.push(place);
      }
    }

    currentPlaces = unique.slice(0, 50);

    renderPlaces(currentPlaces);

    setMarkers([
      {
        lat,
        lng,
        name: "📍 " + currentCity.name,
        description: "Выбранный город",
        color: "#00eaff",
        radius: 0.7,
        alt: 0.025
      },
      ...currentPlaces
    ]);

    message(
      currentPlaces.length
        ? "Найдено мест: " + currentPlaces.length
        : "Поблизости не найдено мест. Попробуй другой город."
    );

  } catch (e) {
    message("Сервис мест временно недоступен. Попробуй позже.");
  } finally {
    searchBusy = false;
  }
}

function renderPlaces(places) {
  const container = $("places");
  container.innerHTML = "";

  if (!places.length) {
    container.innerHTML =
      "<div class='place'>Места пока не найдены.</div>";
    return;
  }

  places.forEach((place, index) => {
    const item = document.createElement("div");
    item.className = "place";

    const name = document.createElement("strong");
    name.textContent = "📍 " + place.name;

    const description = document.createElement("small");
    description.textContent = place.description;

    item.appendChild(name);
    item.appendChild(description);

    item.addEventListener("click", () => {
      globe.controls().autoRotate = false;
      focusLocation(place.lat, place.lng);
      showPlace(place);
    });

    container.appendChild(item);
  });
}

$("city").addEventListener("keydown", event => {
  if (event.key === "Enter") searchCity();
});

startGlobe();
</script>
</body>
</html>
